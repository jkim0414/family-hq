# Copy to .env.local for local development; set the same variables in your host (e.g. Vercel).
# Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
KV_REST_API_URL=            # Upstash Redis (REST)
KV_REST_API_TOKEN=
CRON_SECRET=                # any long random string; guards /api/ingest and /api/digest
APP_URL=https://your-app.vercel.app

# Google OAuth client (Calendar). Redirect URI: <APP_URL>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kimi's own mailbox (sends login codes, digests, and alerts; optional forwarding inbox).
# A Gmail account with an app password works: myaccount.google.com/apppasswords
IMAP_USER=
IMAP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ── Each parent's own Gmail (read-only, via Gmail app passwords; never used to send) ──
GMAIL_IMAP_ALEX_USER=
GMAIL_IMAP_ALEX_PASS=
GMAIL_IMAP_SAM_USER=
GMAIL_IMAP_SAM_PASS=

# ── Optional ──────────────────────────────────────────────────────────────────
# Web push for the installed app. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:assistant@example.com

# Hosted browser for tasks that need one (browserbase.com).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Dev only: drive a local Chromium instead, e.g. http://127.0.0.1:9333
# BROWSER_CDP_URL=

# 1Password service account with read access to ONE vault (logins and cards Kimi may use).
OP_SERVICE_ACCOUNT_TOKEN=
OP_VAULT=Family HQ
# Fallback local credential vault: 64 hex chars (openssl rand -hex 32).
VAULT_KEY=

# SMS via Twilio (US numbers need A2P 10DLC registration). Webhook: <APP_URL>/api/sms (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=   # Kimi's number, e.g. +15551234567 (her identity in the family group text)

# Weather (US National Weather Service; decimal degrees of home) and drive-time region.
WEATHER_LAT=
WEATHER_LON=
# TRAVEL_VIEWBOX=minLon,maxLat,maxLon,minLat   # a box around where you live (optional)
# TRAVEL_REGION=NY                                  # appended to bare place names (optional)

# Model overrides
# AGENT_MODEL=claude-opus-5
# CLASSIFY_MODEL=claude-haiku-4-5
# TRIAGE_MODEL=claude-haiku-4-5
