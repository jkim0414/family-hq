{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?path=:path*"
    },
    {
      "source": "/f/:id",
      "destination": "/api/router?path=file&id=:id"
    },
    {
      "source": "/takeover/:token",
      "destination": "/api/router?path=takeover&token=:token"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/digest?mode=daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/digest?mode=weekly",
      "schedule": "0 0 * * 1"
    }
  ],
  "functions": {
    "api/router.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/kimi.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Kimi.vcf\""
        }
      ]
    }
  ]
}
